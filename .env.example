POSTGRES_DB=cityos
POSTGRES_USER=cityos
POSTGRES_PASSWORD=cityos_dev_password
DATABASE_URL=postgresql+psycopg://cityos:cityos_dev_password@postgres:5432/cityos
SIMULATOR_INTERVAL_SECONDS=5
API_URL=http://api:8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AI provider: ollama or gemini
AI_PROVIDER=ollama

# Google Gemini Developer API - free tier
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Local Ollama
# The Ollama server must be reachable from Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Set this to the exact model shown by: ollama list
OLLAMA_MODEL=
